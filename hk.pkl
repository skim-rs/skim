amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local patch_command = (command, fn) -> (command) {
  command = fn.apply(command)
}

local nightlyfy = (command) -> patch_command(command, (s) -> s.replaceFirst("cargo", "cargo +nightly"))

local features = List("cli", "image", "listen", "frizbee", "''")

local clippies = new Mapping {
  for (feature in features) {
    ["cargo_clippy_feature_\(feature)"] = (Builtins.cargo_clippy) {
      check = patch_command(Builtins.cargo_clippy.check, (s) -> "\(s) --no-default-features --features \(feature) -- -Dwarnings")
      fix = patch_command(Builtins.cargo_clippy.check, (s) -> "\(s) --no-default-features --features \(feature) -- -Dwarnings")
      exclude = List("fuzz/")
    }
  }
}

local linters = new Mapping {
    ["trailing_whitespace"] = (Builtins.trailing_whitespace) {
      exclude = List("wix/", "man/", ".github/ISSUE_TEMPLATE/", ".github/pull_request_template.md")
    }
    ["merge_conflicts"] = Builtins.check_merge_conflict
    ["actionlint"] = (Builtins.actionlint) {
      exclude = List(".github/workflows/release.yml")
    }
    ["cargo_clippy"] = Builtins.cargo_clippy
    ["cargo_fmt"] = (Builtins.cargo_fmt) {
      check = nightlyfy.apply(Builtins.cargo_fmt.check)
      check_list_files = nightlyfy.apply(Builtins.cargo_fmt.check_list_files)
      fix = nightlyfy.apply(Builtins.cargo_fmt.fix)
    }
    ["just_format"] = Builtins.just_format
    ["shellharden"] = (Builtins.shellharden) {
      exclude = List("shell/completion.*")
    }
    // ["zizmor"] = (Builtins.zizmor) { // readd once support for YAML anchors get better
    //   exclude = List(".github/workflows/release.yml")
    // }
  ...clippies
}

steps = linters
